# Copy to .env.local for local development. Never commit real values.

# Supabase (public values are safe for the browser; the service role key is not)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by narrowly scoped server functions, never for user-initiated reads.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. OpenRouter API key for model calls.
OPENROUTER_API_KEY=

# Server only. Optional distributed rate limiting. Leave empty to use the in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Public base URL used in auth emails (confirmation, password reset). Set it in
# production; without it, production sends no explicit redirect and Supabase falls back to its Site URL.
APP_URL=
# Optional. debug | info | warn | error | silent. Defaults to info.
LOG_LEVEL=

# Optional. Cost controls and test mode for the assistant.
# Set to true to turn the assistant off for everyone (kill switch). Chat returns 503.
AI_DISABLED=
# Credits one account may spend per rolling day. Defaults to 50.
AI_DAILY_CREDIT_CAP=
# Leave empty in production. "fake" uses a canned model for tests and is refused in production
# when OPENROUTER_API_KEY is set.
AI_MODEL_MODE=


# Optional. Comma-separated sign-in providers to offer on the login and sign-up pages: google, github,
# apple. Each must also be enabled (client id and secret) in the Supabase dashboard; leave empty to
# show email and password only.
OAUTH_PROVIDERS=
