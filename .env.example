# Copy to .env.local for local development. Never commit real values.

# Supabase (public values are safe for the browser; the service role key is not)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by narrowly scoped server functions, never for user-initiated reads.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. OpenRouter API key for model calls.
OPENROUTER_API_KEY=

# Server only. Optional distributed rate limiting. Leave empty to use the in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
